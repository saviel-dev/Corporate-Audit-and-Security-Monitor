from playwright.sync_api import sync_playwright

def run():
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        page = browser.new_page()
        print("Goto page...")
        page.goto("https://hbe.dcca.hawaii.gov/")
        page.wait_for_timeout(3000)
        
        print("Finding search input...")
        loc = page.get_by_placeholder("Enter a Business Name", exact=False)
        if loc.count() > 0:
            loc.first.fill("ALOHA")
            page.keyboard.press("Enter")
        else:
            print("Placeholder not found.")
            return
            
        print("Waiting for results...")
        page.wait_for_timeout(3000)
        
        links = page.query_selector_all("a")
        print(f"Found {len(links)} links. Printing some:")
        for link in links[:10]:
            print(link.inner_text().strip())
            
        print("\nDumping part of body HTML:")
        print(page.inner_html("body")[:2000])
        browser.close()

if __name__ == "__main__":
    run()
