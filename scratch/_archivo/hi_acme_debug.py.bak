import asyncio
from playwright.async_api import async_playwright
import re

async def run():
    async with async_playwright() as p:
        browser = await p.chromium.launch(headless=True)
        page = await browser.new_page()
        print("Navigating...")
        await page.goto("https://hbe.dcca.hawaii.gov/search-and-buy")
        await page.wait_for_timeout(3000)
        
        print("Searching...")
        await page.get_by_placeholder("Enter a Business Name", exact=False).fill("Acme Holdings LLC")
        await page.get_by_role("button", name="Search").click()
        
        await page.wait_for_timeout(3000)
        
        buttons = await page.locator("button.name-cell-btn").all()
        if buttons:
            print("Clicking result:", await buttons[0].inner_text())
            await buttons[0].click()
            await page.wait_for_timeout(5000)
            
            print("Taking screenshot...")
            await page.screenshot(path="scratch/acme_holdings_hi.png", full_page=True)
            
            # Get HTML
            html = await page.content()
            
            # Print the whole Agent Name block using regex or just print the text
            print("--- FULL PAGE TEXT ---")
            texts = await page.locator(".slds-form-element").all_inner_texts()
            for t in texts:
                if "Agent" in t or "Agent Name" in t:
                    print(f"[{t}]")
            
            print("\n--- HTML SNIPPET ---")
            lines = html.split('\n')
            for i, line in enumerate(lines):
                if 'Agent Name' in line:
                    start = max(0, i-5)
                    end = min(len(lines), i+15)
                    print('\n'.join(lines[start:end]))
                    break

        else:
            print("No results found.")
            
        await browser.close()

if __name__ == "__main__":
    asyncio.run(run())
