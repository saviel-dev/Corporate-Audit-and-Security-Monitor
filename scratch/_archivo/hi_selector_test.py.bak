import asyncio
from playwright.async_api import async_playwright

async def run():
    async with async_playwright() as p:
        browser = await p.chromium.launch(headless=True)
        page = await browser.new_page()
        await page.goto("https://hbe.dcca.hawaii.gov/search-and-buy")
        await page.wait_for_timeout(3000)
        
        await page.get_by_placeholder("Enter a Business Name", exact=False).fill("Acme Holdings LLC")
        await page.get_by_role("button", name="Search").click()
        
        await page.wait_for_timeout(3000)
        buttons = await page.locator("button.name-cell-btn").all()
        if buttons:
            await buttons[0].click()
            await page.wait_for_timeout(5000)
            
            # Try new selector
            loc = page.locator('div.info-label:has(span:has-text("Agent Name")) + div.info-value')
            if await loc.count() > 0:
                print("SUCCESS Agent:", await loc.first.inner_text())
            else:
                print("FAILED Agent selector")
                
            loc_status = page.locator('div.info-label:has(span:has-text("Status")) + div.info-value')
            if await loc_status.count() > 0:
                print("SUCCESS Status:", await loc_status.first.inner_text())
            else:
                print("FAILED Status selector")
        
        await browser.close()

if __name__ == "__main__":
    asyncio.run(run())
