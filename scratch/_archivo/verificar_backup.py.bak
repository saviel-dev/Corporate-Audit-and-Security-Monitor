"""
Punto 2 (v5): Verifica el backup creando las tablas dinamicamente segun el INSERT.
"""
import re
import sqlite3
import os
import collections

BACKUP_PATH = "output/neon_backup_20260812_162020.sql"
DB_TEST = "output/test_restauracion.sqlite3"

if os.path.exists(DB_TEST):
    os.remove(DB_TEST)

with open(BACKUP_PATH, encoding="utf-8") as f:
    sql_raw = f.read()

sentencias = []
for s in sql_raw.split(";\n"):
    s = s.strip()
    if s.upper().startswith("INSERT INTO"):
        sentencias.append(s)

print(f"Total INSERTs en el backup: {len(sentencias)}")

conn = sqlite3.connect(DB_TEST)
cur = conn.cursor()

# Determinar tablas y columnas para el CREATE TABLE
schemas = {}
for s in sentencias:
    m = re.match(r'INSERT INTO (\w+) \((.*?)\)', s, re.IGNORECASE)
    if m:
        tabla = m.group(1)
        cols = m.group(2).replace('"', '').split(', ')
        if tabla not in schemas:
            schemas[tabla] = cols

# Crear tablas
for tabla, cols in schemas.items():
    col_defs = ", ".join(f"{c} TEXT" for c in cols)
    cur.execute(f"CREATE TABLE {tabla} ({col_defs});")

errores = 0
cargados = 0
for s in sentencias:
    s2 = s.replace('TRUE', '1').replace('FALSE', '0')
    try:
        cur.execute(s2)
        cargados += 1
    except Exception as e:
        errores += 1
        if errores <= 3:
            print(f"Error insert: {e}")

conn.commit()

# Contar por tabla en backup
backup_counts = collections.Counter()
for s in sentencias:
    m = re.match(r"INSERT INTO (\w+)", s, re.IGNORECASE)
    if m:
        backup_counts[m.group(1)] += 1

tablas = list(schemas.keys())
print()
print("COMPARACION: Backup vs. Restauracion SQLite")
print("-" * 65)
todas_ok = True
for tabla in tablas:
    cur.execute(f"SELECT COUNT(*) FROM {tabla};")
    sqlite_count = cur.fetchone()[0]
    backup_count = backup_counts.get(tabla, 0)
    ok = "OK" if sqlite_count == backup_count else "DIFERENCIA"
    if sqlite_count != backup_count:
        todas_ok = False
    print(f"  {tabla:20s}: backup={backup_count:4d} | sqlite={sqlite_count:4d} | {ok}")

conn.close()
print()
print(f"INSERTs cargados: {cargados} | Errores: {errores}")
print("RESULTADO:", "Backup VERIFICADO - restaurable." if todas_ok and errores == 0 else "ADVERTENCIA - revisar errores.")
