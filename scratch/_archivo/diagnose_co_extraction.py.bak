import os
import sys
import time

sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))
from app.scrapers.co import ColoradoScraper
from app.scrapers.base import ScrapedRecord
from playwright.sync_api import sync_playwright

def diagnose_extraction():
    ids = ["20141242416", "20031399454"]
    scraper = ColoradoScraper()
    
    try:
        from playwright_stealth import Stealth
        with Stealth().use_sync(sync_playwright()) as p:
            for corp_id in ids:
                print(f"Diagnosing {corp_id}...")
                browser = p.chromium.launch(headless=True, args=["--no-sandbox", "--disable-setuid-sandbox"])
                context = browser.new_context(viewport={"width": 1920, "height": 1080})
                page = context.new_page()
                
                record = ScrapedRecord(corp_name=corp_id, state="CO", search_url="N/A")
                page.goto("https://www.sos.state.co.us/biz/BusinessEntityCriteriaExt.do", wait_until="domcontentloaded")
                
                # Manual steps equivalent to _do_scrape without the extraction part
                page.wait_for_selector("#searchCriteria", timeout=15_000)
                scraper._fill_entity_search(page, corp_id)
                scraper._click_best_result(page, corp_id)
                
                # Save HTML and Screenshot
                page.wait_for_timeout(3000)
                html = page.content()
                with open(f"scratch/co_html_{corp_id}.html", "w", encoding="utf-8") as f:
                    f.write(html)
                page.screenshot(path=f"scratch/co_screenshot_{corp_id}.png")
                
                print(f"Saved HTML and screenshot for {corp_id}")
                page.close()
                browser.close()
                time.sleep(5) # Real flow pause to avoid WAF
    except Exception as e:
        print(f"Error: {e}")

if __name__ == "__main__":
    diagnose_extraction()
