import os
import sys

from dotenv import load_dotenv
load_dotenv()
DATABASE_URL = os.environ.get("DATABASE_URL")
import psycopg2
from psycopg2.extras import RealDictCursor

conn = psycopg2.connect(DATABASE_URL)
cur = conn.cursor(cursor_factory=RealDictCursor)

print("=== 1. TASA REAL DE CO (DESGLOSE) ===")

print("\n--- Por source_file (Historico) ---")
cur.execute("""
    SELECT 
        c.source_file,
        COUNT(s.id) as total_scans,
        SUM(CASE WHEN s.registered_agent_raw IS NOT NULL AND s.registered_agent_raw != '' THEN 1 ELSE 0 END) as exitos
    FROM scan_results s
    JOIN corporations c ON s.corporation_id = c.id
    WHERE c.state = 'CO'
    GROUP BY c.source_file
    ORDER BY total_scans DESC;
""")
for row in cur.fetchall():
    tasa = (row['exitos'] / row['total_scans'] * 100) if row['total_scans'] > 0 else 0
    print(f"  {row['source_file']}: {row['exitos']}/{row['total_scans']} ({tasa:.1f}%)")

print("\n--- Por Run / Fecha (Buscando el fix de stealth) ---")
cur.execute("""
    SELECT 
        r.id as run_id,
        r.started_at::date as fecha,
        COUNT(s.id) as total_scans,
        SUM(CASE WHEN s.registered_agent_raw IS NOT NULL AND s.registered_agent_raw != '' THEN 1 ELSE 0 END) as exitos
    FROM scan_results s
    JOIN corporations c ON s.corporation_id = c.id
    JOIN daily_runs r ON s.daily_run_id = r.id
    WHERE c.state = 'CO'
    GROUP BY r.id, r.started_at::date
    ORDER BY r.id DESC
    LIMIT 10;
""")
for row in cur.fetchall():
    tasa = (row['exitos'] / row['total_scans'] * 100) if row['total_scans'] > 0 else 0
    print(f"  Run #{row['run_id']} ({row['fecha']}): {row['exitos']}/{row['total_scans']} ({tasa:.1f}%)")

print("\n--- Errores mas frecuentes (CO fallidos) ---")
cur.execute("""
    SELECT s.error_message, COUNT(*) as conteo
    FROM scan_results s
    JOIN corporations c ON s.corporation_id = c.id
    WHERE c.state = 'CO' 
      AND (s.registered_agent_raw IS NULL OR s.registered_agent_raw = '')
    GROUP BY s.error_message
    ORDER BY conteo DESC
    LIMIT 5;
""")
for row in cur.fetchall():
    msg = row['error_message'] or "NULL / Vacio"
    print(f"  {row['conteo']} veces: {msg[:80]}")

print("\n=== 2. ORIGEN DE LOS 10 CON CORP_ID ===")
cur.execute("""
    SELECT name, state, corp_id, source_file
    FROM corporations
    WHERE corp_id IS NOT NULL AND corp_id != ''
    ORDER BY state, id;
""")
for row in cur.fetchall():
    print(f"  [{row['state']}] {row['name']} | ID: {row['corp_id']} | Source: {row['source_file']}")

print("\n=== 3. LAS 5 CORPORACIONES DE HAWAII ===")
cur.execute("""
    SELECT id, name, corp_id
    FROM corporations
    WHERE state = 'HI'
    ORDER BY id;
""")
for row in cur.fetchall():
    print(f"  ID: {row['id']} | {row['name']} | corp_id: {row['corp_id'] or 'NULL'}")

conn.close()
