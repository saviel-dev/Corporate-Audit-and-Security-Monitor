from bs4 import BeautifulSoup
import traceback

def analyze(filename):
    print(f"--- Analyzing {filename} ---")
    try:
        with open(filename, 'r', encoding='utf-8') as f:
            soup = BeautifulSoup(f, 'html.parser')

        print('Title:', soup.title.string if soup.title else 'No title')
        forms = soup.find_all('form')
        print(f'Found {len(forms)} forms')

        for f in forms:
            print('Form action:', f.get('action'))
            inputs = f.find_all('input')
            for i in inputs:
                print(f'  Input: type={i.get("type")}, id={i.get("id")}, name={i.get("name")}')

        if soup.find(id='searchCriteria'):
            print('Found #searchCriteria !')
        else:
            print('NO #searchCriteria found.')
            
        body_text = soup.body.text.lower() if soup.body else ''
        if 'cloudflare' in body_text:
            print('Cloudflare detected.')
        if 'captcha' in body_text:
            print('Captcha detected.')
        if 'access denied' in body_text:
            print('Access denied detected.')
    except Exception:
        traceback.print_exc()

analyze('scratch/co_headless.html')
analyze('scratch/co_headful.html')
