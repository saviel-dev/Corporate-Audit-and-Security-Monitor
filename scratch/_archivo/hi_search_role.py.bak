from playwright.sync_api import sync_playwright

def run():
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        page = browser.new_page()
        page.goto("https://hbe.dcca.hawaii.gov/search-and-buy")
        page.wait_for_timeout(4000)
        
        print("Looking for input...")
        loc = page.get_by_placeholder("Enter a Business Name", exact=False)
        if loc.count() > 0:
            print(f"Found input. Filling ALOHA...")
            loc.first.fill("ALOHA")
            
            print("Looking for Search button...")
            btn = page.get_by_role("button", name="Search", exact=True)
            if btn.count() > 0:
                print("Clicking Search button...")
                btn.first.click()
            else:
                print("Pressing Enter...")
                page.keyboard.press("Enter")
        else:
            print("No input found")
            return
            
        page.wait_for_timeout(5000)
        
        print("After search, looking for links in table/results...")
        links = page.locator("a")
        for i in range(links.count()):
            text = links.nth(i).inner_text().strip()
            if text and len(text) > 2 and "ALOHA" in text.upper():
                print(f"Found result link: {text}")
        
        browser.close()

if __name__ == "__main__":
    run()
