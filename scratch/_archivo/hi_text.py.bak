from playwright.sync_api import sync_playwright

def run():
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        page = browser.new_page()
        page.goto("https://hbe.dcca.hawaii.gov/")
        page.wait_for_timeout(4000)
        
        loc = page.locator("input[placeholder*='search' i], input[placeholder*='name' i]")
        if loc.count() > 0:
            print("Found input, filling ALOHA...")
            loc.first.fill("ALOHA")
            
            # Try clicking the search button instead of Enter
            btn = page.locator("button:has-text('Search'), lightning-button button, [data-id='searchButton']")
            if btn.count() > 0:
                print("Clicking search button...")
                btn.first.click()
            else:
                print("Pressing Enter...")
                page.keyboard.press("Enter")
        else:
            print("No input found")
            return
            
        page.wait_for_timeout(5000)
        
        print("Page text content:")
        text = page.inner_text("body")
        print(text[:2000])
        print("...")
        print(text[-2000:])
        
        browser.close()

if __name__ == "__main__":
    run()
