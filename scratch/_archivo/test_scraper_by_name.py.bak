import os
import sys

sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))
from app.scrapers.co import ColoradoScraper
from app.scrapers.base import ScrapedRecord
from playwright.sync_api import sync_playwright

def test_co_scraper_by_name():
    corp_name = "Voices Partners LLC"
    print(f"Probando ColoradoScraper con corp_name: {corp_name}")
    
    scraper = ColoradoScraper()
    record = ScrapedRecord(corp_name=corp_name, state="CO", search_url="N/A")
    
    try:
        from playwright_stealth import Stealth
        with Stealth().use_sync(sync_playwright()) as p:
            browser = p.chromium.launch(headless=True, args=["--no-sandbox", "--disable-setuid-sandbox"])
            context = browser.new_context(viewport={"width": 1920, "height": 1080})
            page = context.new_page()
            
            print("Navegando a Colorado SOS con Stealth...")
            page.goto("https://www.sos.state.co.us/biz/BusinessEntityCriteriaExt.do", wait_until="domcontentloaded")
            scraper._do_scrape(page, corp_name, record)
            
            print("--- RESULTADO DEL SCRAPE ---")
            print(f"Status: {record.portal_status}")
            print(f"Agente Original: {record.registered_agent}")
            print(f"Error: {record.error}")
            if record.error:
                print(f"Mensaje de error: {record.error_message}")
                
            with open("scratch/agentes_crudos.txt", "a", encoding="utf-8") as f:
                f.write(f"\n--- Prueba por NOMBRE (CO) ---\n")
                f.write(f"Nombre: {corp_name}\n")
                f.write(f"Estado: {record.portal_status}\n")
                f.write(f"Agente: {record.registered_agent}\n")
                f.write(f"Error: {record.error_message}\n")
                
            browser.close()
    except Exception as e:
        print(f"Fallo durante la ejecucion del scraper: {e}")

if __name__ == "__main__":
    test_co_scraper_by_name()
